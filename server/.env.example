# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB connection string (MongoDB Atlas free tier works fine to start)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wholesale-hub

# Long random string used to sign JWT auth tokens
JWT_SECRET=replace-this-with-a-long-random-string

# How long a login session stays valid
JWT_EXPIRES_IN=7d

# Port the API server listens on
PORT=5000

# URL of the frontend, used for CORS
CLIENT_URL=http://localhost:5173

# First admin account created by the seed script
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-this-password
