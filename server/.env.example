# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB connection string (MongoDB Atlas free tier works fine to start)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wholesale-hub

# Long random string used to sign JWT auth tokens
JWT_SECRET=replace-this-with-a-long-random-string

# How long a login session stays valid
JWT_EXPIRES_IN=7d

# Port the API server listens on
PORT=5000

# URL of the frontend, used for CORS
CLIENT_URL=http://localhost:5173

# First admin account created by the seed script
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-this-password

# Email notifications (contact form, new account applications, quote requests)
# are sent to ADMIN_EMAIL above. To send them, set up a Gmail "App Password":
#   1. Turn on 2-Step Verification on the Gmail account that will SEND these emails
#      (myaccount.google.com/security)
#   2. Go to myaccount.google.com/apppasswords and create a new app password
#   3. Paste the 16-character password below (NOT your normal Gmail password)
NOTIFY_EMAIL_USER=your-sending-gmail@gmail.com
NOTIFY_EMAIL_APP_PASSWORD=your-16-char-app-password
NOTIFY_FROM_NAME=Trinity Plus Trading Website
